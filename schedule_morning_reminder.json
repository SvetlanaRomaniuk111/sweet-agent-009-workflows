      "parameters": {
        "jsCode": "const orders = $input.all();\nconst date = $now.toFormat('yyyy-MM-dd');\n\nif (!orders || orders[0].json.requested_date === undefined) {\n  return [{\n    json: {\n      message: `🌅 Доброго ранку!\\n\\nНа сьогодні (${date}) замовлень немає.\\n\\nГарного дня! 🍰`\n    }\n  }];\n}\n\nlet text = `🌅 Доброго ранку! Замовлення на сьогодні (${date}):\\n\\n`;\nlet total = 0;\n\norders.forEach((order, index) => {\n  const o = order.json;\n  text += `${index + 1}. ${o.client_name} — ${o.cake_count} шт, ${o.total_price} грн, статус: ${o.status}\\n`;\n  total += Number(o.total_price) || 0;\n});\n\ntext += `\\n💰 Загальна виручка: ${total} грн\\nУдачного дня! 🍰`;\n\nreturn [{ json: { message: text } }];"
      },
